# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
API_VERSION=v1

# Database
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/us_high_lms_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=us_high_lms_dev
